verdict script, verbatim (sha256 above):
--- begin ---
"""Scratch: the pre-registered NOP verdict. Groups come from the COMMITTED control budget's warm compute share
(results/aie/shim_trace_budget_yolov8s_desktop2_20261015T1922Z.json), fixed before this sitting.
python -I verdict.py <budget ctl.json> <budget nop.json>"""
import json
import sys
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[2]
ref = json.loads((ROOT / "results/aie/shim_trace_budget_yolov8s_desktop2_20261015T1922Z.json").read_text(encoding="utf-8"))
cs = np.array([r["compute_share"] for r in ref["layers"]])
G = {"lo (<10%)": cs < 0.10, "mid (10-35%)": (cs >= 0.10) & (cs < 0.35), "hi (>=35%)": cs >= 0.35}
arms = {n: json.loads(Path(p).read_text(encoding="utf-8")) for n, p in (("ctl", sys.argv[1]), ("nop", sys.argv[2]))}
for n, b in arms.items():
    if [r["name"] for r in b["layers"]] != [r["name"] for r in ref["layers"]]:
        raise SystemExit(f"{n}: layer list differs")
KEYS = ("W_bp", "W_mem", "W_move", "W_resid", "A_bp", "A_mem", "A_move", "A_resid", "O_starve")


def frac(b, m, k):
    rows = [r for r, keep in zip(b["layers"], m) if keep]
    return sum(r[k] for r in rows) / sum(r["window"] for r in rows)


def win(b, m=None):
    return sum(r["window"] for r, keep in zip(b["layers"], m if m is not None else [True] * len(b["layers"])) if keep)


def resid_fit(b):
    y = np.array([r["A_resid"] for r in b["layers"]])
    x = np.array([r["a_tasks"] for r in b["layers"]], float)
    A = np.column_stack([x, np.ones(len(y))])
    coef, *_ = np.linalg.lstsq(A, y, rcond=None)
    pred = A @ coef
    return coef, 1 - ((y - pred) ** 2).sum() / ((y - y.mean()) ** 2).sum()


print(f"{'group':14} {'arm':4} {'n':>3} {'ms':>6} " + " ".join(f"{k:>8}" for k in KEYS))
for g, m in G.items():
    for n, b in arms.items():
        print(f"{g:14} {n:4} {m.sum():3d} {win(b, m) / 1.8e6:6.3f} " + " ".join(f"{frac(b, m, k):8.1%}" for k in KEYS))
span = {n: win(b) for n, b in arms.items()}
ratio = span["nop"] / span["ctl"]
print(f"\nframe windows: ctl {span['ctl'] / 1.8e6:.3f} ms, nop {span['nop'] / 1.8e6:.3f} ms (DERIVED); nop/ctl {ratio:.3f}")
lo = G["lo (<10%)"]
dlo = win(arms["nop"], lo) / win(arms["ctl"], lo)
print(f"lo group windows nop/ctl {dlo:.3f}")
fits = {n: resid_fit(b) for n, b in arms.items()}
for n, (coef, r2) in fits.items():
    print(f"A_resid ~ a_tasks [{n}]: {coef[0]:,.0f} cycles per task + {coef[1]:,.0f} per layer, R2 {r2:.2f}")

print("\n== rules (pre-registered) ==")
ok_c = 0.70 <= ratio <= 0.82 and 0.90 <= dlo <= 1.10
ctl_hi_abp = frac(arms["ctl"], G["hi (>=35%)"], "A_bp")
ok_s = 0.15 <= ctl_hi_abp <= 0.25
print(f"C (calibration): nop/ctl frame 0.70-0.82 and lo-group windows 0.90-1.10: {ratio:.3f}, {dlo:.3f} -> "
      f"{'PASS' if ok_c else 'FAIL'}")
print(f"S (stability): ctl hi-group A_bp 15-25% (was 20%): {ctl_hi_abp:.1%} -> {'PASS' if ok_s else 'FAIL'}")
if not (ok_c and ok_s):
    print("C or S failed: P1-P3 are not read")
nop_hi_abp = frac(arms["nop"], G["hi (>=35%)"], "A_bp")
p1 = "COMPUTE" if nop_hi_abp <= 0.05 else "NOT COMPUTE" if nop_hi_abp >= 0.15 else "PARTIAL"
print(f"P1: nop hi-group A_bp {nop_hi_abp:.1%} (<=5% COMPUTE, >=15% NOT COMPUTE, else PARTIAL) -> {p1}")
nop_wbp = frac(arms["nop"], [r["W_move"] / r["window"] > 0.05 for r in ref["layers"]], "W_bp")
p2 = "AHEAD WITHOUT COMPUTE" if nop_wbp >= 0.45 else "WAITED ON COMPUTE" if nop_wbp < 0.30 else "BETWEEN"
print(f"P2: nop W_bp over the 62 weight-moving layers {nop_wbp:.1%} (>=45% ahead without compute, <30% waited on "
      f"compute) -> {p2}")
k_ctl, k_nop = fits["ctl"][0][0], fits["nop"][0][0]
c_ctl, c_nop = fits["ctl"][0][1], fits["nop"][0][1]
p3a = "UNCHANGED" if abs(k_nop / k_ctl - 1) <= 0.25 else "SHRANK" if k_nop < 0.5 * k_ctl else "CHANGED"
p3b = "SHRANK" if c_nop < 0.5 * c_ctl else "UNCHANGED" if abs(c_nop / c_ctl - 1) <= 0.25 else "CHANGED"
print(f"P3a: per-task residual nop/ctl {k_nop / k_ctl:.2f} (within +-25% UNCHANGED = not compute; <0.5 SHRANK) -> {p3a}")
print(f"P3b: per-layer residual nop/ctl {c_nop / c_ctl:.2f} (<0.5 SHRANK = tail was compute; within +-25% UNCHANGED) -> {p3b}")
--- end ---

